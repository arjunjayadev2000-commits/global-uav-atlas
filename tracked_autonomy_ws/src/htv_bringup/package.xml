<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>htv_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, the simulation_safe.yaml configuration, ROS graph validation and
    system-level integration tests for the simulation-only HTV research stack.
  </description>
  <maintainer email="arjunjayadev2000@gmail.com">HTV research team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>htv_interfaces</exec_depend>
  <exec_depend>htv_description</exec_depend>
  <exec_depend>htv_dynamics</exec_depend>
  <exec_depend>htv_vehicle_interface</exec_depend>
  <exec_depend>htv_safety</exec_depend>
  <exec_depend>htv_sim</exec_depend>
  <exec_depend>htv_gazebo</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>tf2_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
