<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>htv_sim</name>
  <version>0.1.0</version>
  <description>
    Simulated heavy tracked vehicle plant (headless or Gazebo-coupled) and simulation-only
    support nodes (phase health stubs, failure injection).
  </description>
  <maintainer email="arjunjayadev2000@gmail.com">HTV research team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>htv_interfaces</exec_depend>
  <exec_depend>htv_common</exec_depend>
  <exec_depend>htv_dynamics</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
