# Copy to .env and adjust. Never commit .env - it is gitignored.

# --- Vision verification (optional) ---------------------------------------
# Without a key the pipeline still runs and falls back to metadata-based
# identity verification, flagging low-confidence images for manual review.
ANTHROPIC_API_KEY=
UAV_VISION_ENABLED=1
UAV_VISION_MODEL=claude-sonnet-5
# 0 = verify every selected image
UAV_VISION_MAX_CALLS=0

# --- Database --------------------------------------------------------------
UAV_DB_PATH=data/uav_atlas.sqlite

# --- Networking ------------------------------------------------------------
UAV_USER_AGENT=GlobalUAVVisualAtlas/1.0 (research dataset compilation; contact via repository issues)
UAV_REQUEST_TIMEOUT=30
UAV_MAX_RETRIES=4
UAV_BACKOFF_BASE=2
# Requests per second per host
UAV_RATE_LIMIT_RPS=1
UAV_RESPECT_ROBOTS=1
UAV_HTTP_CACHE=1
UAV_HTTP_CACHE_TTL=604800
# Set to 1 to forbid all outbound requests (offline rebuild of the atlas)
UAV_OFFLINE=0

# --- Images ----------------------------------------------------------------
UAV_IMAGE_MIN_WIDTH=500
UAV_IMAGE_PREFERRED_WIDTH=800
UAV_IMAGE_MAX_BYTES=26214400
UAV_THUMBNAIL_WIDTH=320
UAV_ATLAS_IMAGE_WIDTH=640
UAV_GENERATE_WEBP=1
# Leave at 0 if the atlas may be distributed commercially
UAV_ALLOW_NC_LICENSES=0

# --- Deduplication ---------------------------------------------------------
UAV_DEDUPE_AUTO=0.94
UAV_DEDUPE_REVIEW=0.86

# --- Discovery -------------------------------------------------------------
UAV_DISCOVERY_EMPTY_PASSES=3
UAV_DISCOVERY_MAX_PASSES=12

# --- Logging ---------------------------------------------------------------
UAV_LOG_LEVEL=INFO
